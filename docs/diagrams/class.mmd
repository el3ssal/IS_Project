%% Class diagram — APPENDIX (AS-BUILT, schema v4)
%% Real dataclasses from wedding_hall_system/logic/models.py, plus the
%% three Phase 7 service classes appended at the end (BackupService,
%% SettingsService, CalendarService — services, not dataclasses).
%% Field types are simplified for the diagram (the code uses int | None,
%% datetime | None, list[str] / list[int] where a value may be absent).
%% Money is integer piasters everywhere; datetimes are venue time (Africa/Cairo).
%% Note: models.py has NO separate dataclass for the link tables
%% (employee_roles, package_halls, package_services, service_halls,
%% package_event_types, role_permissions) — those are plain join rows in SQL,
%% shown here as associations. Employee.roles is a list of role names.

classDiagram
    class Role {
        +int id
        +string name
        +string description
    }
    class Permission {
        +int id
        +string code
        +string description
    }
    class Employee {
        +int id
        +string username
        +string full_name
        +string phone
        +string email
        +string specialties
        +bool is_active
        +list roles
        +display_name() string
        +has_role(role) bool
    }
    class Session {
        +int id
        +int employee_id
        +string token_hash
        +datetime expires_at
        +is_expired(now) bool
    }
    class Hall {
        +int id
        +string name
        +string description
        +int capacity
        +int base_price
        +string status
        +list facilities
        +string notes
        +bool is_active
        +is_bookable() bool
        +facilities_json() string
    }
    class HallWeeklyHours {
        +int id
        +int hall_id
        +int weekday
        +string open_time
        +string close_time
        +bool is_closed
    }
    class HallSpecialHours {
        +int id
        +int hall_id
        +string date
        +string open_time
        +string close_time
        +bool is_closed
        +string reason
    }
    class MaintenanceBlock {
        +int id
        +int hall_id
        +string type
        +string description
        +datetime start_at
        +datetime end_at
        +int recorded_by
    }
    class EventType {
        +int id
        +string name
        +int default_duration_min
        +bool is_active
    }
    class Package {
        +int id
        +string name
        +string description
        +int base_price
        +int default_duration_min
        +int min_duration_min
        +int included_guests
        +int extra_guest_price
        +bool is_active
        +list hall_ids
        +list event_type_ids
        +list service_ids
    }
    class Service {
        +int id
        +string name
        +string description
        +string pricing_method
        +int unit_price
        +bool is_active
        +list hall_ids
    }
    class PricingRule {
        +int id
        +string name
        +int hall_id
        +int package_id
        +int event_type_id
        +int weekday
        +string season
        +string adjustment_type
        +int adjustment_value
        +bool is_active
        +matches(...) bool
    }
    class ServiceSelection {
        +int service_id
        +int quantity
        +int duration_min
    }
    class PriceItem {
        +string kind
        +string label
        +int amount
    }
    class PriceBreakdown {
        +list items
        +int hall_id
        +int package_id
        +int event_type_id
        +int guests
        +int duration_min
        +total() int
        +total_by_kind(kind) int
    }
    class Customer {
        +int id
        +string full_name
        +string phone
        +string phone_normalized
        +string email
        +string email_normalized
        +string address
        +string national_id
        +string notes
        +list additional_phones
        +masked_national_id() string
    }
    class CustomerInteraction {
        +int id
        +int customer_id
        +int employee_id
        +string type
        +string summary
    }
    class Quotation {
        +int id
        +string number
        +int customer_id
        +int hall_id
        +int event_type_id
        +int package_id
        +datetime start_at
        +datetime end_at
        +int guest_count
        +int total_amount
        +string status
        +datetime valid_until
        +int created_by
        +is_expired_by_time() bool
    }
    class QuotationItem {
        +int id
        +int quotation_id
        +string kind
        +string label
        +int amount
    }
    class Booking {
        +int id
        +string number
        +int customer_id
        +int hall_id
        +int quotation_id
        +int event_type_id
        +int package_id
        +datetime start_at
        +datetime end_at
        +int guest_count
        +string status
        +int total_amount
        +int deposit_required
        +int deposit_paid
        +datetime hold_expires_at
        +datetime grace_expires_at
        +string additional_contact_phone
        +string notes
        +int previous_booking_id
