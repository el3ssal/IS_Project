        +string scope_type
        +int scope_id
        +int recorded_by
        +string approval_status
        +string payment_status
    }
    class Refund {
        +int id
        +int payment_id
        +int booking_id
        +int amount
        +string reason
        +string method
        +string status
        +int created_by
        +int approved_by
        +datetime approved_at
        +datetime paid_at
    }
    class Contract {
        +int id
        +string number
        +int booking_id
        +string template_name
        +int current_version_id
        +string signature_status
        +string signature_date
    }
    class ContractVersion {
        +int id
        +int contract_id
        +int version
        +string body
        +int created_by
    }
    class Attachment {
        +int id
        +string entity_type
        +int entity_id
        +string original_filename
        +string storage_filename
        +string mime_type
        +int size_bytes
        +string category
        +int uploaded_by
        +bool is_deleted
    }
    class EmployeeAvailability {
        +int id
        +int employee_id
        +string date
        +string start_time
        +string end_time
        +string kind
        +string note
    }
    class EventPlan {
        +int id
        +int booking_id
    }
    class TaskTemplate {
        +int id
        +string name
        +int event_type_id
        +int package_id
        +bool is_active
    }
    class TaskTemplateItem {
        +int id
        +int template_id
        +string name
        +string description
        +int default_due_offset_min
        +string priority
    }
    class Task {
        +int id
        +int event_plan_id
        +int booking_id
        +int service_id
        +string name
        +string description
        +int assigned_to
        +string priority
        +datetime due_at
        +string status
    }
    class TaskHistory {
        +int id
        +int task_id
        +int employee_id
        +string action
        +string old_value
        +string new_value
    }
    class Notification {
        +int id
        +int recipient_role_id
        +int recipient_employee_id
        +string type
        +string title
        +string body
        +string priority
        +string entity_type
        +int entity_id
        +bool is_read
    }

    %% ---- Phase 7 services (logic/backup_service.py,
    %% logic/settings_service.py, logic/calendar_service.py) ----
    %% Real public methods; employee is the acting Employee in each call.
    %% DatabaseManager and BookingService are shown only as collaborators,
    %% with the members these three services actually call.
    class BackupService {
        +DatabaseManager db
        +AppSettings settings
        +Path dir
        +create_backup(employee) dict
        +list_backups(employee) list
        +download_backup(employee, backup_id) Path
        +validate_backup(employee, backup_id) dict
        +restore_backup(employee, backup_id, confirm) dict
    }
    class SettingsService {
        +DatabaseManager db
        +AppSettings settings
        +list_settings(employee) list
        +update_setting(employee, key, raw_value) dict
    }
    class CalendarService {
        +DatabaseManager db
        +AppSettings settings
        +BookingService bookings
        +list_events(employee, date_from, date_to, hall_id) list
        +booking_detail(employee, booking_id) dict
        +reschedule_from_calendar(employee, booking_id, new_start_at, new_end_at, reason) Booking
    }
    class DatabaseManager {
        +backup_to(dest) tuple
        +current_version() int
    }
    class BookingService {
        +reschedule_booking(employee, booking_id, new_start_at, new_end_at, reason) Booking
    }

    %% ---- associations (mirror the schema.sql foreign keys) ----
    Employee "1" -- "0..*" Role : holds
    Employee "1" -- "0..*" Session : logs in with
    Hall "1" -- "0..*" HallWeeklyHours : has
    Hall "1" -- "0..*" HallSpecialHours : has
    Hall "1" -- "0..*" MaintenanceBlock : blocked by
    Package "0..*" -- "0..*" Hall : suitable for
    Package "0..*" -- "0..*" EventType : suitable for
    Package "0..*" -- "0..*" Service : includes
    Service "0..*" -- "0..*" Hall : can be hosted in
    PricingRule "0..*" -- "0..1" Hall : applies to
    PricingRule "0..*" -- "0..1" Package : applies to
    PricingRule "0..*" -- "0..1" EventType : applies to
    PriceBreakdown "1" *-- "1..*" PriceItem : consists of
    Customer "1" -- "0..*" CustomerInteraction : has
    Customer "1" -- "0..*" Quotation : receives
    Quotation "1" *-- "0..*" QuotationItem : frozen price of
    Quotation "0..1" -- "0..1" Booking : converts to
    Customer "1" -- "0..*" Booking : books
    Hall "1" -- "0..*" Booking : hosts
    Package "0..1" -- "0..*" Booking : priced by
    EventType "0..1" -- "0..*" Booking : typed as
    Booking "1" -- "0..*" BookingHistory : timeline of
    Booking "1" -- "0..1" Booking : rebooks from
    Booking "1" -- "0..*" Payment : paid by
    Booking "1" -- "0..*" Installment : split into
    Payment "1" -- "0..*" Refund : refunded by
    Booking "1" -- "1" Contract : has
    Contract "1" *-- "1..*" ContractVersion : versioned as
    Booking "1" -- "1" EventPlan : planned as
    EventPlan "1" *-- "0..*" Task : checklist of
    TaskTemplate "1" *-- "1..*" TaskTemplateItem : lines of
    TaskTemplate "0..*" -- "0..*" EventType : matches
    TaskTemplate "0..*" -- "0..*" Package : matches
    Task "0..*" -- "0..1" Service : delivers
    Task "0..*" -- "0..1" Employee : assigned to
    Task "1" -- "0..*" TaskHistory : history of
    Employee "1" -- "0..*" EmployeeAvailability : declares
    Employee "1" -- "0..*" Notification : receives
    Role "1" -- "0..*" Notification : targeted at
    Employee "1" -- "0..*" Expense : records
    Employee "1" -- "0..*" Payment : records
    Employee "1" -- "0..*" Attachment : uploads

    %% ---- Phase 7 service associations ----
    BackupService --> DatabaseManager : uses
    SettingsService --> DatabaseManager : uses
    CalendarService --> DatabaseManager : uses
    CalendarService --> BookingService : delegates reschedule to
